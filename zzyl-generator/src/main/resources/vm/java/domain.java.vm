## =====================================================================
## domain.java.vm —— 实体类代码生成模板（Velocity Template Language）
##
## 【Velocity 基础语法速览】
##   ${var} / $var        ：取值（引用上下文中的变量，${} 是正规写法，大括号可
##                          明确变量边界，如 ${packageName}.domain）
##   $obj.method()        ：调用 Java 对象的方法，如 $column.readConverterExp()
##   $obj.property        ：属性取值，等价于 getProperty()，如 $column.javaType
##   #foreach($x in $xs)  ：循环遍历集合，#end 结束
##   #if / #elseif / #else：条件分支，#end 结束；||、&&、! 与 Java 含义相同
##   #set($a = xxx)       ：定义/赋值模板内局部变量
##   ##                   ：单行注释（本文件用的就是它）。注意：## 会吞掉本行
##                          换行符，所以注释行不会在生成的 .java 文件里留下空行
##   #* ... *#            ：多行块注释（本文件未使用）
##
## 【模板上下文变量来源】
##   由 GenUtils#/VelocityInitializer 把 GenTable/GenTableColumn 等对象
##   放入 VelocityContext：$packageName（包名）、$importList（需导入的包集合）、
##   $columns（GenTableColumn 列表）、$table（GenTable，含 crud/tree/sub 类型
##   标记与 isSuperColumn() 等方法）、$ClassName（类名）、$functionName（功能名）、
##   $tableName（表名）、$author、$datetime、$subClassName/$subclassName（子表类名）。
##   注意：模板里 $table.isSuperColumn(...) 这类写法是直接调用 Java 方法。
## =====================================================================
## 包声明：${packageName} 由代码生成配置中的“包路径”传入
package ${packageName}.domain;

## #foreach 循环 $importList 集合，为每个需要导出的字段类型生成一条 import。
## $import 本身就是完整类名字符串（如 java.util.Date），所以直接 ${import} 输出
#foreach ($import in $importList)
import ${import};
#end

import com.zzyl.common.annotation.Excel;
## 按表类型选择父类导入：单表(crud)/主子表(sub)继承 BaseEntity（自带
## createBy/createTime 等通用字段）；树表(tree)继承 TreeEntity（自带 parentId/children）。
## #if 条件里 $table.crud、$table.sub、$table.tree 是 GenTable 的布尔属性
#if($table.crud || $table.sub)
import com.zzyl.common.core.domain.BaseEntity;
#elseif($table.tree)
import com.zzyl.common.core.domain.TreeEntity;
#end

import lombok.Data;  ## 导入lombok的依赖
import lombok.AllArgsConstructor;
import lombok.NoArgsConstructor;

import io.swagger.annotations.ApiModel;
import io.swagger.annotations.ApiModelProperty;
/**
 * ${functionName}对象 ${tableName}
 *
 * @author ${author}
 * @date ${datetime}
 */
## #set 定义局部变量 $Entity，供下面类声明处 ${Entity} 引用；
## 必须放在类声明之前，且分支要与上面的 import 分支保持一致
#if($table.crud || $table.sub)
#set($Entity="BaseEntity")
#elseif($table.tree)
#set($Entity="TreeEntity")
#end

@Data  ## 添加lombok的注解
@NoArgsConstructor
@AllArgsConstructor
@ApiModel("${functionName}实体")
public class ${ClassName} extends ${Entity}
{
    private static final long serialVersionUID = 1L;

## 外层 #foreach 遍历所有列 $columns，内层 #if 用 !$table.isSuperColumn()
## 过滤掉父类已有字段（如 createBy/updateTime 等写在 BaseEntity 里的字段），
## 避免子类重复声明。注意 ! 是否定，方法调用结果取反
#foreach ($column in $columns)
#if(!$table.isSuperColumn($column.javaField))
    /** $column.columnComment */
## 只有勾选了“列表显示”（$column.list 为 true）的字段才加 @Excel 导出注解
#if($column.list)
## 下面三行是“字典值截取”逻辑：字段备注形如“状态（0禁用 1启用）”时，
## indexOf("（") 定位中文左括号（注意是全角括号，不是半角），把括号前面
## 的纯名称截出来做 Excel 列名；找不到括号（返回 -1）则用完整备注
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
## 三种 @Excel 形态：①含字典备注 → 带 readConverterExp 做“0=禁用”正反向
## 转换；②Date 类型 → 固定日期格式；③普通字段 → 只写列名。
## 其中 $column.readConverterExp() 是调用 Java 方法生成 "0=禁用,1=启用" 字符串
#if($parentheseIndex != -1)
    @Excel(name = "${comment}", readConverterExp = "$column.readConverterExp()")
#elseif($column.javaType == 'Date' || $column.javaType == 'LocalDateTime')
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm;ss")
    @Excel(name = "${comment}", width = 30, dateFormat = "yyyy-MM-dd")
#else
    @Excel(name = "${comment}")
#end
#end
    @ApiModelProperty("${column.columnComment}")
    private $column.javaType $column.javaField;

#end
#end
## 主子表模式（$table.sub 为 true）追加“子表集合”属性，如 orderItemList；
## ${subClassName} 首字母大写（类名）、${subclassName} 首字母小写（属性名）
#if($table.sub)
    /** $table.subTable.functionName信息 */
    private List<${subClassName}> ${subclassName}List;

#end



}
